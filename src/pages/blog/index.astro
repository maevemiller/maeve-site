---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Writing — Maeve">
  <a href={`${import.meta.env.BASE_URL}`} class="label hover:text-accent transition-colors">&larr; maeve.world</a>
  <h1 class="title-font text-3xl mt-4 mb-10">Writing</h1>
  <div class="reveal border-t border-border">
    {entries.map((entry, i) => (
      <a href={`${import.meta.env.BASE_URL}blog/${entry.id}`} class="group flex flex-col py-6 border-b border-border hover:bg-fg/[0.02] hover:translate-x-1 transition-all -mx-2 px-2">
        <div class="flex items-baseline justify-between gap-4">
          <div class="flex items-baseline gap-3">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display text-lg group-hover:text-accent transition-colors">{entry.data.title}</h3>
          </div>
          <span class="label whitespace-nowrap">
            {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
          </span>
        </div>
        {entry.data.excerpt && <p class="text-sm text-muted font-light mt-2 max-w-md ml-8">{entry.data.excerpt}</p>}
      </a>
    ))}
  </div>
</Layout>
