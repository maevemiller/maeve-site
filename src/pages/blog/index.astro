---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Writing — Maeve">
  <h1 class="text-2xl font-medium mb-8">Writing</h1>
  <div class="flex flex-col divide-y divide-border">
    {entries.map((entry) => (
      <a href={`/blog/${entry.id}`} class="py-5 group">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="font-medium group-hover:text-accent transition-colors">{entry.data.title}</h3>
          <span class="text-xs font-mono text-muted whitespace-nowrap">
            {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
        </div>
        {entry.data.excerpt && <p class="text-sm text-muted mt-1">{entry.data.excerpt}</p>}
      </a>
    ))}
  </div>
</Layout>
