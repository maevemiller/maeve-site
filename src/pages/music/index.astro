---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReviewCard from '../../components/ReviewCard.astro';

const entries = (await getCollection('music')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Music — Maeve">
  <a href="/" class="label hover:text-accent transition-colors">&larr; maeve.world</a>
  <h1 class="display text-3xl mt-4 mb-10">Music</h1>
  <div class="reveal border-t border-border">
    {entries.map((entry, i) => (
      <ReviewCard
        href={`/music/${entry.id}`}
        title={entry.data.title}
        rating={entry.data.rating}
        date={entry.data.date}
        blurb={entry.data.blurb}
        meta={entry.data.artist}
        image={entry.data.image}
        index={i}
      />
    ))}
  </div>
</Layout>
