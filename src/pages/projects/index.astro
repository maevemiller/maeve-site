---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Projects — Maeve">
  <h1 class="text-2xl font-medium mb-8">Projects</h1>
  <div class="grid gap-4">
    {entries.map((entry) => (
      <div class="rounded-lg border border-border bg-card p-5">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <h3 class="font-medium">{entry.data.title}</h3>
          <div class="flex gap-3 text-sm font-mono">
            {entry.data.github && (
              <a href={entry.data.github} class="text-muted hover:text-accent" target="_blank" rel="noopener">github</a>
            )}
            {entry.data.liveUrl && (
              <a href={entry.data.liveUrl} class="text-muted hover:text-accent" target="_blank" rel="noopener">live</a>
            )}
          </div>
        </div>
        <p class="text-sm text-muted mt-2">{entry.data.description}</p>
        {entry.data.tags.length > 0 && (
          <div class="flex gap-2 flex-wrap mt-4">
            {entry.data.tags.map((tag) => (
              <span class="text-xs font-mono text-muted border border-border rounded px-2 py-0.5">{tag}</span>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</Layout>
