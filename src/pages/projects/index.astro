---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Projects — Maeve">
  <a href="/" class="label hover:text-accent transition-colors">&larr; maeve.world</a>
  <h1 class="display text-3xl mt-4 mb-10">Projects</h1>
  <div class="reveal border-t border-border">
    {entries.map((entry, i) => (
      <div class="py-6 border-b border-border hover:translate-x-1 transition-transform">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex items-baseline gap-3">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display text-lg">{entry.data.title}</h3>
          </div>
          <div class="flex gap-4">
            {entry.data.github && (
              <a href={entry.data.github} class="label hover:text-accent" target="_blank" rel="noopener">github</a>
            )}
            {entry.data.liveUrl && (
              <a href={entry.data.liveUrl} class="label hover:text-accent" target="_blank" rel="noopener">live</a>
            )}
          </div>
        </div>
        <p class="text-sm text-muted font-light mt-3 max-w-md ml-8">{entry.data.description}</p>
        {entry.data.tags.length > 0 && (
          <div class="flex gap-3 flex-wrap mt-4 ml-8">
            {entry.data.tags.map((tag) => (
              <span class="label">{tag}</span>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</Layout>
