---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('travel');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} — Maeve`}>
  <a href="/travel" class="label hover:text-fg transition-colors">&larr; Travel</a>
  <h1 class="display text-3xl mt-5">{entry.data.title}</h1>
  <p class="label mt-2">{entry.data.location}</p>
  <p class="label mt-1">
    {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
  </p>
  {entry.data.photo && (
    <Image src={entry.data.photo} alt={entry.data.title} width={800} class="mt-8 w-full object-cover" />
  )}
  <article class="prose prose-neutral dark:prose-invert mt-8 max-w-none">
    <Content />
  </article>
</Layout>
