---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('travel');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} — Maeve`}>
  <a href="/travel" class="text-sm text-muted hover:text-fg">&larr; Travel</a>
  <h1 class="text-2xl font-medium mt-4">{entry.data.title}</h1>
  <p class="text-sm text-muted mt-1">{entry.data.location}</p>
  <p class="text-xs font-mono text-muted mt-2">
    {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
  </p>
  {entry.data.photo && (
    <Image src={entry.data.photo} alt={entry.data.title} width={800} class="mt-6 rounded-lg w-full object-cover" />
  )}
  <article class="prose prose-neutral dark:prose-invert mt-8 max-w-none">
    <Content />
  </article>
</Layout>
