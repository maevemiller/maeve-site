---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('travel')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Travel — Maeve">
  <h1 class="text-2xl font-medium mb-8">Travel</h1>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
    {entries.map((entry) => (
      <a href={`/travel/${entry.id}`} class="group block">
        <div class="aspect-square rounded-lg overflow-hidden bg-card border border-border">
          {entry.data.photo && (
            <Image
              src={entry.data.photo}
              alt={entry.data.title}
              width={400}
              height={400}
              class="w-full h-full object-cover group-hover:opacity-80 transition-opacity"
            />
          )}
        </div>
        <p class="text-sm font-medium mt-2">{entry.data.title}</p>
        <p class="text-xs text-muted">{entry.data.location}</p>
      </a>
    ))}
  </div>
</Layout>
