---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('travel')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Travel — Maeve">
  <a href={`${import.meta.env.BASE_URL}`} class="label hover:text-accent transition-colors">&larr; maeve.world</a>
  <h1 class="title-font text-3xl mt-4 mb-10">Travel</h1>
  <div class="reveal grid grid-cols-2 sm:grid-cols-3 gap-px bg-border">
    {entries.map((entry) => (
      <a href={`${import.meta.env.BASE_URL}travel/${entry.id}`} class="group block bg-bg">
        <div class="aspect-square overflow-hidden bg-card">
          {entry.data.photo && (
            <Image
              src={entry.data.photo}
              alt={entry.data.title}
              width={400}
              height={400}
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-[1.03] transition-all duration-500"
            />
          )}
        </div>
        <div class="p-3">
          <p class="text-sm display group-hover:text-accent transition-colors">{entry.data.title}</p>
          <p class="label mt-1">{entry.data.location}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>
