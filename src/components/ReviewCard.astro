---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import RatingStars from './RatingStars.astro';

interface Props {
  href: string;
  title: string;
  rating: number;
  date: Date;
  blurb?: string;
  meta?: string;
  image?: ImageMetadata;
  index?: number;
}

const { href, title, rating, date, blurb, meta, image, index } = Astro.props;
---

<a
  href={href}
  class="group flex gap-5 py-6 border-b border-border hover:bg-fg/[0.02] hover:translate-x-1 transition-all -mx-2 px-2"
>
  {image && (
    <Image
      src={image}
      alt=""
      width={88}
      height={88}
      class="size-20 sm:size-24 object-cover shrink-0 grayscale group-hover:grayscale-0 transition-[filter]"
    />
  )}
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-baseline gap-3">
        {typeof index === 'number' && <span class="idx">{String(index + 1).padStart(2, '0')}</span>}
        <div>
          <h3 class="display text-lg group-hover:text-accent transition-colors">{title}</h3>
          {meta && <p class="label mt-1">{meta}</p>}
        </div>
      </div>
      <RatingStars rating={rating} />
    </div>
    {blurb && <p class="text-sm text-muted font-light mt-3 max-w-md">{blurb}</p>}
    <p class="label mt-4">
      {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
    </p>
  </div>
</a>
