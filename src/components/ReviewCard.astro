---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import RatingStars from './RatingStars.astro';

interface Props {
  href: string;
  title: string;
  rating: number;
  date: Date;
  blurb?: string;
  meta?: string;
  image?: ImageMetadata;
}

const { href, title, rating, date, blurb, meta, image } = Astro.props;
---

<a
  href={href}
  class="flex gap-4 rounded-lg border border-border bg-card p-5 hover:border-accent transition-colors"
>
  {image && (
    <Image
      src={image}
      alt=""
      width={80}
      height={80}
      class="size-20 rounded object-cover shrink-0"
    />
  )}
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="font-medium">{title}</h3>
        {meta && <p class="text-sm text-muted mt-0.5">{meta}</p>}
      </div>
      <RatingStars rating={rating} />
    </div>
    {blurb && <p class="text-sm text-muted mt-3">{blurb}</p>}
    <p class="text-xs font-mono text-muted mt-4">
      {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    </p>
  </div>
</a>
